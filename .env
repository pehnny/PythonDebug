# .env exposé sur le git !!!!
# solution -> .env.exemple avec données bidon

# Si ce .env est utilisé en prod
# On est en mode debug !
DEBUG=True
FLASK_ENV=development
# password db trop faible
DATABASE_URL=postgresql://app:1234@db:5432/app
# passphrase jwt trop faible
JWT_KEY=1234
# CORS * => le browser va accepter d'envoyer des requêtes depuis
# n'importe quel urls.
# CORS = Cross Origin Ressources Sharing
CORS_ORIGIN=*
# Exemple de prod :
# CORS_ORIGIN="https://myfront.be/,https://myotherfront.com/"
